{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-mediapipe-wasm.mjs && next dev",
    "build": "node scripts/copy-mediapipe-wasm.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "node scripts/test-pg.mjs",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/seed.ts",
    "probe:elevenlabs": "tsx scripts/probe-elevenlabs.ts",
    "gen:demo-audio": "node --conditions=react-server --import tsx scripts/gen-demo-audio.ts",
    "sig:ref": "python3 -I -X utf8 docs/signature_reference/reference_engine.py data/nasa",
    "urine:json": "python3 -I -X utf8 scripts/urine_xlsx_to_json.py",
    "demo:checkins": "tsx scripts/gen-demo-checkins.ts",
    "demo:audio": "node --conditions=react-server --import tsx scripts/gen-signature-audio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@base-ui/react": "^1.9.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@rive-app/react-canvas": "^4.39.0",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "14.13.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
