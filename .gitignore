# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MediaPipe runtime copied from node_modules before dev / build (scripts/copy-mediapipe-wasm.mjs)
/public/mediapipe/

# local SQLite database (seeded by `pnpm db:seed`)
/data/*
# NASA OSDR source files for Signature Triage (read-only, must reach CI and the Vercel bundle)
!/data/nasa/
# urine panel workbook for the dashboard's Labs tab (source of src/data/urine_panel.json, scripts/urine_xlsx_to_json.py)
!/data/urine/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode (the Signature Triage reference scripts import each other)
__pycache__/
