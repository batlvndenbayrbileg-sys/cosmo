# Copy to .env.local and fill in. Keys are read on the server only — never prefix them with NEXT_PUBLIC_.

# live = real Claude + ElevenLabs; scripted = no network, pre-generated audio + scripted dialogue
DEMO_MODE=live

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MN=
ELEVENLABS_VOICE_ID_EN=

# optional overrides
# scribe_v3 writes numbers as digits and heard Mongolian numbers correctly where scribe_v2 did not
ELEVENLABS_STT_MODEL=scribe_v3
# Mongolian is listed only for eleven_v4 / eleven_v4_turbo (checked live with GET /v1/models)
ELEVENLABS_TTS_MODEL_MN=eleven_v4_turbo
# empty = pick automatically at startup from GET /v1/models
ELEVENLABS_TTS_MODEL_EN=

# local SQLite file (default shown); tests use :memory:
AEGIS_DB_PATH=data/aegis.db

# Postgres instead of SQLite (required on Vercel, where each instance would otherwise have its own copy).
# Supabase: Project -> Connect -> "Transaction pooler" URI (port 6543), with your database password filled in.
# Tables are created and the demo crew is seeded automatically on first use.
DATABASE_URL=

# signs the session cookie; empty = random per process (sessions reset on restart)
SESSION_SECRET=

# used for "mission day" on the dashboards
MISSION_START_DATE=2026-10-01
